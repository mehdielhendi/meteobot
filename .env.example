# App
APP_NAME=Chatbot Météorologique
APP_ENV=development
DEBUG=true

# Optional LLM (leave empty to use rule-based intents)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Weather provider: open-meteo (default, no key) | openweather
WEATHER_PROVIDER=open-meteo
OPENWEATHER_API_KEY=

# Local DRMNO OBS bulletins
OBS_SOURCE_DIR=sources/obs_horaire
OBS_DATA_PATH=data/obs/hourly.json
OBS_DAILY_SOURCE_DIR=sources/obs_quotidienne
OBS_DAILY_DATA_PATH=data/obs/daily.json
BMS_DATA_PATH=data/obs/bms_alerts.json
SPECIAL_DATA_PATH=data/obs/special_forecasts.json
PFA_SOURCE_DIR=sources/bulletins

# Default station when none is specified
DEFAULT_CITY=Rabat
DEFAULT_LAT=34.0209
DEFAULT_LON=-6.8416
